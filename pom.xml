<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Parent-less aggregator (spec 6, section 3.2). Each module takes sequeless-build-parent directly. -->
  <groupId>org.sequeless</groupId>
  <artifactId>sequeless-filter</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>Sequeless Filter</name>
  <description>Human-readable filter/query DSL: AST model, ANTLR 4 grammar, parser, serializer,
    operator and field registries, and completion utilities. No Spring dependency.</description>
  <url>https://sequeless.org</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <module>filter-core</module>
    <module>filter-sql-adapter</module>
  </modules>

  <repositories>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

</project>
