{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "maven",
  "include-component-in-tag": true,
  "plugins": [
    {
      "type": "maven-workspace"
    }
  ],
  "packages": {
    "filter-core": {
      "component": "filter-core",
      "versioning": "always-bump-patch",
      "skip-snapshot": true
    },
    "filter-sql-adapter": {
      "component": "filter-sql-adapter",
      "versioning": "always-bump-patch",
      "skip-snapshot": true
    },
    "filter-sql-testkit": {
      "component": "filter-sql-testkit",
      "initial-version": "0.1.0",
      "versioning": "always-bump-patch",
      "skip-snapshot": true
    },
    "filter-sql-postgres-adapter": {
      "component": "filter-sql-postgres-adapter",
      "initial-version": "0.1.0",
      "versioning": "always-bump-patch",
      "skip-snapshot": true
    }
  }
}
