{
  "name": "sequeless-filter",
  "image": "mcr.microsoft.com/devcontainers/java:21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem",
      "installMaven": "false"
    }
  },
  "remoteEnv": {
    "JAVA_HOME": "/usr/local/sdkman/candidates/java/current"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.vscode-xml"
      ]
    }
  }
}
